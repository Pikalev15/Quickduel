NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Use a modern sb_secret_ key; never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Optional server-only HTTPS error-ingestion endpoint.
OBSERVABILITY_DSN=
# Required in production. Use at least 32 random bytes and rotate deliberately.
RATE_LIMIT_HASH_KEY=
# Cloudflare Turnstile. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional emergency/manual trigger for /api/cron/finalize-matches.
CRON_SECRET=
# Local development only. Never set true in preview or production.
ABUSE_CHALLENGE_DEV_BYPASS=false
